APP_NAME=ParkCity
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Belgrade
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Nova baza (kreiraj je u phpMyAdmin-u): parkcity_angular
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=parkcity_angular
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Adrese sa kojih Angular sme da zove API (odvojeno zarezom)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
